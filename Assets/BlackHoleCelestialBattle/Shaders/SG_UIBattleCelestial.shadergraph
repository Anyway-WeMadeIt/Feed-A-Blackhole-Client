        },
        {
            "m_Id": "c6b7762bc273439d8c515c1f5fbcaeda"
        },
        {
            "m_Id": "e6ba23faf9f647b986faaccee69fe679"
        },
        {
            "m_Id": "b0b06a50f7ba4ecd8c1e08a1ab8d84f8"
        },
        {
            "m_Id": "b36ab89c00d6486e80d6d5da4a3c5ecb"
        },
        {
            "m_Id": "fa61de2dae424375a0e4a396d2033b29"
        },
        {
            "m_Id": "65b1aa17de864dfba8048f458fb621db"
        },
        {
            "m_Id": "99a6269a43b74a2abdf4418d7d6ec805"
        },
        {
            "m_Id": "270d57914cce498dad48fb73603e88f0"
        },
        {
            "m_Id": "463b594bd110469ab86a39970321b449"
        },
        {
            "m_Id": "52a91d0ae34142c492a5e2fb49141b19"
        },
        {
            "m_Id": "c01f6324b90f49fba00b60c1208baa2f"
        },
        {
            "m_Id": "728353fd5a8e43b4bc552ed16e2a3c6f"
        },
        {
            "m_Id": "f98cdf99f41243e7ab851c32b62c38bc"
        },
        {
            "m_Id": "0b5ce0b7b4f447099e34f80bb8d3a19d"
        },
        {
            "m_Id": "5dbb7e7d2bc6486181217437ec9303b6"
        },
        {
            "m_Id": "075995438a5244a7aed2bb4af5bb6c71"
        },
        {
            "m_Id": "74e305ea2de74a7ca5a61dc4bbdee596"
        },
        {
            "m_Id": "cb4a060e12874e5bb732fc5ee5970395"
        },
        {
            "m_Id": "4906719a151b42dd9330a235d3477b8a"
        },
        {
            "m_Id": "5cd919326fdb4e278170ffeec5c9ee8b"
        }
    ],
    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CelestialBattle",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float t = lerp(Time, Clock, step(0.5, UseExternalClock));\nfloat2 p = (UV - float2(CenterX, CenterY)) * float2(max(Aspect, 0.01), 1.0) / max(PatternSize, 0.01);\nfloat a = radians(t * RotationSpeed);\nfloat cs = cos(a), sn = sin(a);\nfloat2 q = float2(cs*p.x + sn*p.y, -sn*p.x + cs*p.y) + 0.5;\nfloat inside = step(0.0,q.x)*step(q.x,1.0)*step(0.0,q.y)*step(q.y,1.0);\nfloat3 m = SAMPLE_TEXTURE2D(Masks.tex, Masks.samplerstate, q).rgb;\nfloat4 f = SAMPLE_TEXTURE2D(Flow.tex, Flow.samplerstate, q);\nfloat phase = atan2(f.g-0.5, f.r-0.5) / 6.28318530718;\nfloat d = frac(t*FlowSpeed + f.a - phase);\nfloat head = exp(-pow(min(d,1.0-d)/0.007,2.0));\nfloat tail = exp(-d/0.035)*step(d,0.16);\nfloat gate = smoothstep(0.0,0.12,frac(t/17.0+f.a)) * (1.0-smoothstep(0.65,0.85,frac(t/17.0+f.a)));\nfloat twinkle = 0.7 + 0.3*sin(t*TwinkleSpeed + dot(q,float2(73.0,127.0)));\nfloat l = m.r * LineOpacity * LineColor.a;\nfloat s = (m.g*twinkle + m.b*0.2)*StarOpacity + f.b*(head+tail*0.35)*gate*FlowOpacity;\ns *= StarColor.a;\nColor = (LineColor.rgb*l + StarColor.rgb*s)/max(l+s,0.00001);\n// Protect the central gameplay region in screen UV, regardless of pattern rotation.\nfloat edgeDistance = max(abs(UV.x-0.5), abs(UV.y-0.5));\nfloat edgeFade = smoothstep(0.28, 0.46, edgeDistance);\nAlpha = saturate(l+s)*saturate(OverallOpacity)*inside*edgeFade;"
}

